# Local development only. Never commit real passwords or keys.
# M1A database smoke tests use the local Supabase database; no remote credentials needed.
# DATABASE_URL=postgresql://<local-user>:<local-password>@127.0.0.1:54322/postgres
# Later collector jobs will use secrets with least-privileged database roles.
# Manual Apple and Steam diagnostics: set a strong server-only secret in Vercel.
# Never prefix this variable with VITE_ or commit a real token.
# DEV_COLLECT_TOKEN=
